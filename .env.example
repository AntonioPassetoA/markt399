# ===============================================
# Painel de Clientes - Variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# ===============================================

# --- Supabase ---
# Encontre em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Chave secreta (service_role). NUNCA exponha no front-end.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Google Sheets (Service Account) ---
# E-mail da Service Account (algo como conta@projeto.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=conta@projeto.iam.gserviceaccount.com
# Chave privada da Service Account. Mantenha as quebras de linha como \n (com aspas).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# ID da planilha (parte da URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=1AbCdEf...
# Nome da aba onde os dados serão inseridos
GOOGLE_SHEET_TAB_NAME=Clientes

# --- Administradores ---
# Lista de e-mails (separados por vírgula) que terão acesso de admin.
ADMIN_EMAILS=admin@email.com,gerente@email.com
